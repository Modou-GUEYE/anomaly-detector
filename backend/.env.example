# =============================================================================
# TEMPLATE D'ENVIRONNEMENT — LAB Anomaly Detector
# =============================================================================
# Copier ce fichier vers .env et remplir toutes les valeurs marquées CHANGE_ME
# NE PAS committer le fichier .env (il est dans .gitignore)
# =============================================================================

# =============================================================================
# IDENTITÉ PARTENAIRE
# =============================================================================
PARTNER_BANK_CODE=SN079

# =============================================================================
# JWT / SÉCURITÉ
# =============================================================================
# Chemin vers la clé privée RSA (doit être montée dans le conteneur Docker)
KEY_JWT_PRIVATE_KEY_FILE=/app/keys/jwt_private.pem

# TTL des tokens d'accès en minutes (0 = pas d'expiration)
KEY_JWT_ACCESS_TTL_MIN=0

# Noms de rôles (ne pas modifier sauf refonte du modèle de droits)
KEY_ROLE_ADMIN=admin
KEY_ROLE_ANALYST=analyst
KEY_ROLE_SYSTEM=system

# =============================================================================
# BASE DE DONNÉES PostgreSQL
# =============================================================================
DEV_DB_NAME=CHANGE_ME
DEV_DB_USER=CHANGE_ME
DEV_DB_PASSWORD=CHANGE_ME
DEV_DB_HOST=CHANGE_ME
DEV_DB_PORT=5432

# --- Pool de connexions (valeurs validées en tests de charge 500 utilisateurs) ---
# Ne pas réduire en dessous de ces seuils sans re-validation
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=5m

# --- Logging GORM : silent | error | warn | info ---
# En production : silent (réduit la contention I/O sur stdout)
DB_LOG_LEVEL=silent

# --- Comportement au démarrage ---
DB_CHECK_SIGNATURE=false
DB_AUTO_MIGRATE=true
DB_SSL_DISABLE=true

# =============================================================================
# BACKEND (Go / Gin)
# =============================================================================
PORT=8080

# Mode Gin : release (prod) | debug (dev)
# release désactive les logs verbeux et réduit la charge CPU/IO
GIN_MODE=release

BASE_URL_API=http://CHANGE_ME:8080/
URL_ANALYZE_TRANSACTION=http://CHANGE_ME:8080/api/v1/anomalies/analyze

# =============================================================================
# FRONTEND (Angular / Nginx)
# =============================================================================
FRONTEND_API_URL=http://CHANGE_ME:8080/api/v1
FRONTEND_PORT=80

# URL de réinitialisation de mot de passe envoyée par email aux utilisateurs
# Doit pointer vers l'URL publique du frontend (ex: http://10.70.1.145/forgot-password ou https://lab.domaine.sn/forgot-password)
PASSWORD_RESET_URL=http://CHANGE_ME/forgot-password

# =============================================================================
# SMTP (Notifications email)
# =============================================================================
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME
SMTP_FROM_NAME=Moteur de détection d'anomalies - LAB
