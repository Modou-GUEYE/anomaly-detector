# ========== Comportement application ==========
# Vérification signature base au démarrage
DB_CHECK_SIGNATURE=false
# Auto-migration au démarrage (activé par défaut pour initialisation)
DB_AUTO_MIGRATE=true
# SSL désactivé en dev local
DB_SSL_DISABLE=true

