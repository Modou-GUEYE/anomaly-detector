# Backend environment template (no real secrets)

# Partner identity
PARTNER_BANK_CODE=SN079

# JWT
KEY_JWT_PRIVATE_KEY_FILE=/app/keys/jwt_private.pem
KEY_JWT_ACCESS_TTL_MIN=0
KEY_ROLE_ADMIN=admin
KEY_ROLE_ANALYST=analyst
KEY_ROLE_SYSTEM=system

# Database (dev example)
DEV_DB_NAME=anomaly_db
DEV_DB_USER=anomaly_user
DEV_DB_PASSWORD=CHANGE_ME
DEV_DB_HOST=localhost
DEV_DB_PORT=5432

# Backend
PORT=8080
BASE_URL_API=http://localhost:8080/
URL_ANALYZE_TRANSACTION=http://localhost:8080/api/v1/anomalies/analyze

# Frontend
FRONTEND_API_URL=http://localhost:8080/api/v1
FRONTEND_PORT=80

# App behavior
DB_CHECK_SIGNATURE=false
DB_AUTO_MIGRATE=true
DB_SSL_DISABLE=true

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Moteur de détection d'anomalies - LAB
