


/mda-ui (frontend)
|-- /src
|   |-- /app
|   |   |-- /_helpers     # Contient les intercepteurs (pour JWT) et les gardes de routes.
|   |   |-- /_services    # Services pour communiquer avec l'API backend (auth.service...).
|   |   |-- /auth         # Composants liés à l'authentification (page de login).
|   |   |-- /components   # Composants partagés (header, footer, sidebar...).
|   |   |-- /models       # Interfaces TypeScript (user.ts, alerte.ts...) qui reflètent les modèles Go.
|   |   |-- /pages        # Composants principaux de l'application (Dashboard, Alertes, Règles...).
|   |   |-- app-routing.module.ts # Gère la navigation et les routes de l'application.
|   |   `-- app.module.ts   # Module principal de l'application Angular.
|   |-- /assets           # Fichiers statiques (images, icônes).
|   `-- ...
|-- angular.json          # Fichier de configuration du projet Angular.
`-- tailwind.config.js    # Fichier de configuration pour le framework de style Tailwind CSS.
